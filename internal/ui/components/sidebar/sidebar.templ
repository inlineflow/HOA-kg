package sidebar

// import "hypermedia/internal/component"

import (
	"fmt"
	"github.com/google/uuid"
	"hypermedia/internal/ui/components/icons"
)

templ Sidebar(houseID uuid.UUID) {
	<div class="drawer lg:drawer-open">
		<input type="checkbox" id="my-drawer-1" class="drawer-toggle"/>
		<div class="drawer-content">
			<!-- <label for="my-drawer-1" class="btn drawer-button">Open drawer</label> -->
			<main class="flex flex-col justify-center items-center p-24">
				{ children... }
			</main>
		</div>
		<div class="drawer-side">
			<label for="my-drawer-1" aria-label="close sidebar" class="drawer-overlay"></label>
			<ul class="menu bg-base-200 min-h-full w-80 p-4">
				@SidebarDropdown(houseID)
				<!-- <li><a href="/houses">Дома</a></li> -->
				<!-- <li><a href="/payment-plans">Планы сборов</a></li> -->
			</ul>
		</div>
	</div>
}

type SidebarEntry struct {
	Icon      func(attrs ...templ.Attributes) templ.Component
	Label     string
	LinkChunk string
}

func sidebarLink(houseID, chunk string) string { return fmt.Sprintf("/houses/%s/%s", houseID, chunk) }

func entries() []SidebarEntry {
	return []SidebarEntry{
		{
			Icon:      icons.DoorClosed,
			Label:     "Квартиры",
			LinkChunk: "flats",
		},
		{
			Icon:      icons.NotebookText,
			Label:     "Планы сборов",
			LinkChunk: "payment-plans",
		},
	}
}

templ SidebarDropdown(houseID uuid.UUID) {
	<div tabindex="0" class="collapse bg-base-100 border-base-300 border">
		<input type="checkbox"/>
		<div class="collapse-title font-semibold flex items-center gap-2">
			<!-- @Home() -->
			@icons.HouseIcon(templ.Attributes{
				"class": "size-4",
			})
			<span>Дома</span>
		</div>
		<div class="collapse-content text-sm">
			for _, e := range entries() {
				<li>
					<a href={ sidebarLink(houseID.String(), e.LinkChunk) }>
						@e.Icon()
						<span>{ e.Label }</span>
					</a>
				</li>
			}
		</div>
	</div>
}
