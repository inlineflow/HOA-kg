package ui

import "hypermedia/internal/models"
import "fmt"
import "github.com/google/uuid"

templ ServeHouses(houses []models.House) {
	@NoSidebarLayout("ТСЖ") {
		@templ.Fragment("partial") {
			<div class="flex flex-col gap-4">
				@HousesIndexControls()
				<!-- <div class="flex items-center justify-center max-w-64"> -->
				@HousesGrid(houses)
				<!-- </div> -->
			</div>
		}
	}
}

templ CreateHouse() {
	@NoSidebarLayout("Создание дома") {
		@templ.Fragment("partial") {
			<div>
				<form hx-post="/houses/create" hx-push-url="true">
					<fieldset class="fieldset bg-base-300 border-base-200 rounded-box w-xs border p-4">
						<legend class="fieldset-legend">Дом</legend>
						<label for="address" class="label">Адрес</label>
						<input name="address" type="text" id="address" class="input"/>
						<button class="btn btn-neutral mt-4">Создать</button>
					</fieldset>
				</form>
			</div>
		}
	}
}

templ HousesIndexControls() {
	<div class="flex justify-center">
		<a href="/houses/create" class="btn btn-primary">Добавить дом</a>
	</div>
}

templ HousesGrid(houses []models.House) {
	<div class="grid grid-cols-4 gap-4">
		for _, h := range houses {
			<div class="card card-lg shadow-md">
				<a href={ "/houses/" + h.ID.String() + "/flats" } hx-boost="false">
					<div class="card-body text-lg">
						<p>{ h.Address }</p>
					</div>
				</a>
			</div>
		}
	</div>
}

templ HouseView(h models.House, flats []models.Flat) {
	@SidebarLayout(h.Address, h.ID) {
		@templ.Fragment("partial") {
			@House(h, flats)
		}
	}
}

templ House(h models.House, flats []models.Flat) {
	<h2 class="text-2xl font-bold mb-24">「{ h.Address }」</h2>
	<div class="flex flex-col gap-4">
		<!-- @CreateFlatsForm(h) -->
		@HouseManagementControls(h)
		@FlatsTable(flats)
	</div>
}

templ HouseManagementControls(h models.House) {
	<div x-data>
		<a class="btn btn-neutral btn-outline" href={ fmt.Sprintf("/houses/%s/flats/create", h.ID) }>Создание карточек</a>
		<!-- <button class="btn btn-neutral btn-outline" @click="$refs.modal.showModal()">Создание карточек</button> -->
		<!-- <dialog x-ref="modal" class="modal" id="controls-modal"> -->
		<!-- 	<div class="modal-box flex flex-col gap-8 py-8 justify-center items-center"> -->
		<!-- 		<button @click="$refs.modal.close()" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button> -->
		<!-- 		@CreateFlatsForm(h) -->
		<!-- 		<button @click="$refs.modal.close()" class="btn btn-neutral self-start btn-outline">Закрыть</button> -->
		<!-- 	</div> -->
		<!-- </dialog> -->
	</div>
}

templ CreateFlats(houseID uuid.UUID) {
	@SidebarLayout("Создание карточки", houseID) {
		@templ.Fragment("partial") {
			@CreateFlatsForm(houseID)
		}
	}
}

templ FlatsFormErrorField(msg, fieldID string) {
	<div class="outline-2 outline-error rounded-field flex" id={ fieldID + "_error" }>
		<span class="my-auto mx-2">{ msg }</span>
	</div>
}

templ FlatsFormField(labelMsg, id string) {
	<label class="label" for={ id }>{ labelMsg }</label>
	<input class="input " name={ id } id={ id } type="number"/>
	@FlatsFormErrorField("456", id)
}

templ CreateFlatsForm(houseID uuid.UUID) {
	<form hx-post={ "/houses/" + houseID.String() + "/flats" } hx-push-url="true">
		<div class="rounded-box grid grid-cols-4 gap-2 border px-4 py-8 border-neutral-400">
			<div class="grid grid-cols-3 gap-4 col-span-4 col-start-1">
				@FlatsFormField("Номер квартиры", "flat_number")
				<!-- <label class="label" for="flat_number">Номер квартиры</label> -->
				<!-- <input class="input " name="flat_number" id="flat_number" type="number" min="1" max="2"/> -->
				<!-- @FlatsFormErrorField("456", "flat_number") -->
				<!-- <div class="outline-2 outline-error rounded-field flex" id="flat_number_error"> -->
				<!-- 	<span class="my-auto mx-2">123</span> -->
				<!-- </div> -->
				@FlatsFormField("Имя владельца", "flat_owner_name")
				<!-- <label class="label" for="flat_owner_name">Имя владельца</label> -->
				<!-- <input class="input" name="flat_owner_name" id="flat_owner_name" type="text" minlength="8"/> -->
				<!-- <div class="invisible" id="flat_owner_name_error">123</div> -->
				<label class="label" for="flat_owner_phone_number">Номер телефона владельца</label>
				<input class="input" name="flat_owner_phone_number" id="flat_owner_phone_number" type="text"/>
				<div class="invisible" id="flat_owner_phone_number_error">123</div>
				<label class="label" for="flat_area">Площадь (м<sup>2</sup>)</label>
				<input class="input" name="flat_area" id="flat_area" type="number"/>
				<div class="invisible" id="flat_area_error">123</div>
			</div>
			<!-- <div class="flex col-span-4 col-start-2 gap-4"> -->
			<!-- 	<label class="label">Номер квартиры</label> -->
			<!-- 	<input class="input flex-1" type="number"/> -->
			<!-- </div> -->
			<!-- <div class="flex col-span-4 col-start-2 gap-4"> -->
			<!-- 	<label class="label">Имя владельца</label> -->
			<!-- 	<input class="input flex-1" type="text"/> -->
			<!-- </div> -->
			<!-- <div class="flex col-span-4 col-start-2 gap-4"> -->
			<!-- 	<label class="label">Номер телефона владельца</label> -->
			<!-- 	<input class="input flex-1" type="text"/> -->
			<!-- </div> -->
			<!-- <div class="flex col-span-4 col-start-2 gap-4"> -->
			<!-- 	<label class="label"><span>Площадь (м<sup>2</sup>)</span></label> -->
			<!-- 	<input class="input flex-1" type="number"/> -->
			<!-- </div> -->
		</div>
	</form>
}

