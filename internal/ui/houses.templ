templ FlatsTable(flats []models.Flat) {
	<table class="table rounded-box border border-base-content/5 bg-base-100">
		<thead>
			<tr>
				<th>
					Номер квартиры
				</th>
			</tr>
		</thead>
		<tbody>
			for _, f := range flats {
				<tr>
					<td>{ f.FlatNumber }</td>
				</tr>
			}
		</tbody>
	</table>
}
